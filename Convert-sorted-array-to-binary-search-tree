class Solution {
    public TreeNode tree(int[] nums,int l,int h){
        if(l>h)return null;
        int m=(l+h)/2;
        TreeNode root=new TreeNode(nums[m]);
        root.left=tree(nums,l,m-1);
        root.right=tree(nums,m+1,h);
        return root;
    }
    public TreeNode sortedArrayToBST(int[] nums) {
        int n=nums.length;
        return tree(nums,0,n-1);
    }
}
