class Solution {
    public List<Integer> spiralOrder(int[][] mat) {
        List<Integer>ans=new ArrayList<>();
        int n=mat.length;
        int m=mat[0].length;
        int fr=0;
        int lr=n-1;
        int fc=0;
        int lc=m-1;
        while(fr<=lr && fc<=lc){
            for(int j=fc;j<=lc;j++){
                ans.add(mat[fr][j]);
            }
            fr++;
            if(fr>lr || fc>lc) break;
            for(int i=fr;i<=lr;i++){
                ans.add(mat[i][lc]);
            }
            lc--;
            if(fr>lr || fc>lc) break;
            for(int j=lc;j>=fc;j--){
                ans.add(mat[lr][j]);
            }
            lr--;
            if(fr>lr || fc>lc) break;
            for(int i=lr;i>=fr;i--){
                ans.add(mat[i][fc]);
            }
            fc++;

        }
        return ans;
    }
}
